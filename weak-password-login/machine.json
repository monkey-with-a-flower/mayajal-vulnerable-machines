{
  "name": "Weak Password Payroll",
  "image": "mayajal/weak-password-login:demo",
  "os_type": "Linux",
  "description": "Demo payroll web app with an instance-specific weak credential.",
  "ports": ["8080"],
  "network_aliases": ["payroll", "weak-password-login"],
  "restart_policy": "unless-stopped",
  "tty": true,
  "detection": {
    "network": {
      "suricata": ["detections/network/weak-password-login.rules"]
    },
    "logs": {
      "application": ["detections/application-logs/failed-login.json"],
      "system": []
    }
  }
}
